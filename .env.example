# Copy to .env and fill in real values. .env is gitignored; this template is not.
# Docker Compose reads .env automatically for the MAIL_* passthrough in docker-compose.yml.

MAIL_ENABLED=true
# Gmail: must be the FULL address of the account the App Password belongs to
MAIL_USERNAME=you@gmail.com
# 16-character App Password (requires 2-Step Verification enabled on that account)
MAIL_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM=you@gmail.com
