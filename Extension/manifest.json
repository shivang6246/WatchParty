{
  "manifest_version": 3,
  "name": "WatchParty",
  "description": "Watch YouTube together in sync with friends.",
  "version": "1.0.1",

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },

  "permissions": [
    "storage",
    "tabs",
    "activeTab",
    "scripting",
    "identity",
    "alarms"
  ],

  "host_permissions": [
    "http://localhost:8080/*",
    "ws://localhost:8080/*",
    "http://15.252.237.89:8081/*",
    "ws://15.252.237.89:8081/*",
    "https://*.youtube.com/*",
    "https://*.netflix.com/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "WatchParty",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.netflix.com/*"
      ],
      "js": ["content.js"]
    }
  ]
}